[importlinter]
root_packages =
    d810
    tests
include_external_packages = True
exclude_type_checking_imports = True

[importlinter:contract:unit-tests-no-hexrays]
name = Unit tests must not import hexrays modules
type = forbidden
source_modules =
    tests.unit
forbidden_modules =
    d810.hexrays
ignore_imports =
    tests.unit.test_mop_snapshot_guard -> d810.hexrays.mop_snapshot
    # Tests that only exercise egglog availability (skip when IDA absent) but
    # transitively import the canonical egglog backend which pulls in
    # d810.hexrays.expr.ast. They run under --forked in CI only when egglog
    # is installed; the import-time IDA dependency is exercised in
    # tests/system/runtime.
    tests.unit.test_rule_analysis -> d810.backends.mba.egglog_backend
    tests.unit.test_egglog_pattern_gen -> d810.backends.mba.egglog_backend
    tests.unit.test_ida_pattern_generation -> d810.backends.mba.egglog_backend

[importlinter:contract:unit-tests-no-ui]
name = Unit tests must not import ui modules
type = forbidden
source_modules =
    tests.unit
forbidden_modules =
    d810.ui

[importlinter:contract:unit-tests-no-optimizers]
name = Unit tests must not import optimizers modules
type = forbidden
source_modules =
    tests.unit
forbidden_modules =
    d810.optimizers

[importlinter:contract:actions-no-direct-ida-imports]
name = Actions modules must not directly import IDA packages
type = forbidden
allow_indirect_imports = True
source_modules =
    d810.ui.actions
forbidden_modules =
    idaapi
    ida_kernwin
    ida_hexrays
    ida_loader
    ida_funcs
    ida_fpro
    ida_lines
    idc
    idautils
    idapro

# ---------------------------------------------------------------------------
# Architecture consolidation contracts (canonical-only internal imports)
# ---------------------------------------------------------------------------
# These contracts prevent new internal imports of legacy duplicate modules
# while still allowing:
#   - The legacy modules themselves (they ARE the shims).
#   - Compatibility tests that explicitly exercise the shim surface.
# Update the `ignore_imports` section when adding a new compatibility test.
# ---------------------------------------------------------------------------

[importlinter:contract:no-legacy-hexrays-utils]
name = Production source must import the canonical hexrays.utils package
type = forbidden
source_modules =
    d810.optimizers
    d810.evaluator
    d810.expr
    d810.backends
    d810.recon
    d810.speedups
    d810.cfg
    d810.manager
forbidden_modules =
    d810.hexrays.arch_utils
    d810.hexrays.hexrays_formatters
    d810.hexrays.hexrays_helpers
    d810.hexrays.ida_utils
    d810.hexrays.table_utils

[importlinter:contract:no-legacy-hexrays-hooks]
name = Production source must import the canonical hexrays.hooks package
type = forbidden
source_modules =
    d810.optimizers
    d810.evaluator
    d810.expr
    d810.backends
    d810.recon
    d810.speedups
    d810.cfg
    d810.manager
forbidden_modules =
    d810.hexrays.hexrays_hooks
    d810.hexrays.ctree_hooks

[importlinter:contract:no-legacy-hexrays-ir]
name = Production source must import the canonical hexrays.ir package
type = forbidden
source_modules =
    d810.optimizers
    d810.evaluator
    d810.expr
    d810.backends
    d810.recon
    d810.speedups
    d810.cfg
    d810.manager
forbidden_modules =
    d810.hexrays.mop_snapshot
    d810.hexrays.block_helpers

[importlinter:contract:no-legacy-hexrays-mutation]
name = Production source must import the canonical hexrays.mutation package
type = forbidden
source_modules =
    d810.optimizers
    d810.evaluator
    d810.expr
    d810.backends
    d810.recon
    d810.speedups
    d810.cfg
    d810.manager
forbidden_modules =
    d810.hexrays.deferred_modifier
    d810.hexrays.cfg_utils

[importlinter:contract:no-legacy-mba-backends]
name = Production source must import the canonical backends.mba package
type = forbidden
source_modules =
    d810.optimizers
    d810.evaluator
    d810.expr
    d810.recon
    d810.speedups
    d810.cfg
    d810.manager
forbidden_modules =
    d810.mba.backends.ida
    d810.mba.backends.z3
    d810.mba.backends.egraph
    d810.mba.backends.egglog_backend

[importlinter:contract:no-legacy-d810-expr-ast]
name = Production source must import the canonical d810.hexrays.expr.ast dispatcher
type = forbidden
source_modules =
    d810.optimizers
    d810.evaluator
    d810.expr
    d810.backends
    d810.recon
    d810.speedups
    d810.cfg
    d810.manager
forbidden_modules =
    d810.expr.ast
ignore_imports =
    # The shim itself naturally re-exports from the canonical module.
    d810.expr.ast -> d810.hexrays.expr.ast
    d810.expr.ast -> d810.hexrays.ir.minsn_utils
    d810.expr.ast -> d810.hexrays.ir.mop_utils
    d810.expr.ast -> d810.core
    # The dedicated compatibility test verifies the shim's identity contract.
    tests.system.runtime.test_ast_class_identity -> d810.expr.ast